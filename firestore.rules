rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Require a signed-in Firebase Auth user for every Tech Academia profile document.
    match /users/{uid} {
      // Users can read only their own profile document.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Users can create only their own profile document.
      allow create: if request.auth != null && request.auth.uid == uid;

      // Users can update only their own profile document.
      allow update: if request.auth != null && request.auth.uid == uid;

      // Users can delete only their own profile document.
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Users can access only nested documents under their own profile, such as chats.
      match /{document=**} {
        // Authenticated users can read/write nested documents only below their own uid.
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Deny all other collections and documents by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
